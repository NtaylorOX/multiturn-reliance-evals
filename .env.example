# Provider keys read by Inspect AI. Copy to .env and fill in; never commit .env.
# NVIDIA free endpoint: used for the simulator, the judge and one target model
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# Open-weight models served locally with Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: export traces to an OTLP collector (leave unset to skip)
OTEL_EXPORTER_OTLP_ENDPOINT=
