# Provider keys read by Inspect AI. Copy to .env and fill in; never commit .env.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Open-weight model served locally with Ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
# Optional: export traces to an OTLP collector (leave unset to skip)
OTEL_EXPORTER_OTLP_ENDPOINT=
